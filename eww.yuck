    (button :class "launcher-item"
      :onclick "code &"
      "VSCODE")))

(defpoll vpnstatus :interval "5s"
  "if pgrep openvpn > /dev/null; then echo 'CONNECTED'; else echo 'OFFLINE'; fi")

(defpoll vpnip :interval "5s"
  "if pgrep openvpn > /dev/null; then echo \"IP: $(curl -s --max-time 5 icanhazip.com 2>/dev/null || echo 'TUNNEL ACTIVE')\"; else echo 'IP: HIDDEN'; fi")

(defpoll vpnserver :interval "30s"
  "if pgrep openvpn > /dev/null; then echo 'SERVER: US-FREE-111'; else echo 'SERVER: NONE'; fi")

(defpoll vpnuptime :interval "5s"
  "if pgrep openvpn > /dev/null; then echo \"UPTIME: $(ps -o etime= -p $(pgrep openvpn) | tr -d ' ')\"; else echo 'UPTIME: N/A'; fi")

(defwindow vpn
  :monitor 0
  :geometry (geometry
    :x "14px"
    :x "0px"
    :y "0px"
    :width "700px"
    :height "55px"
    :anchor "center top")
  :stacking "bg"
  :exclusive false
  (box :class "vpn-box"
    :orientation "h"
    :space-evenly true
    :spacing 12
    (label :class "vpn-title" :text "⬡ VPN")
    (label :class "vpn-status" :text {vpnstatus})
    (label :class "vpn-ip" :text {vpnip})
    (label :class "vpn-server" :text {vpnserver})
    (label :class "vpn-uptime" :text {vpnuptime})
    (button :class "vpn-btn-on"
      :onclick "vpn-on &"
      "[+ON+]")
    (button :class "vpn-btn-off"
      :onclick "vpn-off &"
      "[-OFF-]")))



(defpoll net_count :interval "60s"
  "sudo /home/saint14/.local/bin/wifi-count.sh")

(defpoll net_time :interval "1s"
  "date '+%H:%M:%S'")

(defpoll net_devices :interval "60s"
  "sudo /home/saint14/.local/bin/wifi-devices.sh")

(defpoll net_scroll :interval "0.2s"
  "sudo /usr/local/bin/net-scroll.sh")

(defwindow netmonitor
  :monitor 0
  :geometry (geometry
    :x "0px"
    :y "72px"
    :width "900px"
    :height "36px"
    :anchor "center bottom")
  :stacking "bg"
  :exclusive false
  (box :class "net-bar"
    :orientation "h"
    :space-evenly false
    :spacing 0
    (button :class "net-btn"
      :onclick "kcmshell6 kcm_networkmanagement &"
      "󰖩 WIFI")
    (label :class "net-sep" :text " // ")
    (label :class "net-title" :text "⬡ NET")
    (label :class "net-sep" :text " // ")
    (label :class "net-item" :text {"DEVICES: ${net_count}"})
    (label :class "net-sep" :text " // ")
    (label :class "net-item" :text {net_scroll})
    (label :class "net-sep" :text " // ")
    (label :class "net-scan" :text {"SCAN: ${net_time}"})
    (label :class "net-sep" :text " // ")
    (button :class "net-btn"
      :onclick "blueman-manager &"
      "󰂯 BT")))

(defpoll sysbar_conn :interval "5s"
  "/home/saint14/.local/bin/active-conn.sh")

(defpoll conn_scroll :interval "0.2s"
  "/home/saint14/.local/bin/conn-scroll.sh")

(defpoll sysbar_ssh :interval "30s"
  "sudo /home/saint14/.local/bin/failed-ssh.sh")

(defpoll sysbar_fw :interval "30s"
  "sudo /usr/local/bin/ufw-status.sh")

(defpoll sysbar_clip :interval "2s"
  "/home/saint14/.local/bin/clipboard-status.sh")

(defpoll sysbar_vol :interval "2s"
  "/home/saint14/.local/bin/mute-status.sh")

(defpoll sysbar_bt :interval "5s"
  "/home/saint14/.local/bin/bt-device.sh")

(defwindow sysbar
  :monitor 0
  :geometry (geometry
    :x "0px"
    :y "108px"
    :width "800px"
    :height "36px"
    :anchor "center bottom")
  :stacking "bg"
  :exclusive false
  (box :class "sys-bar"
    :orientation "h"
    :space-evenly false
    :spacing 0
    (label :class "sys-title" :text "⬡ SYS")
    (label :class "sys-sep" :text " // ")
    (label :class "sys-item" :text {sysbar_fw})
    (label :class "sys-sep" :text " // ")
    (button :class "sys-btn"
      :onclick "pactl set-sink-mute @DEFAULT_SINK@ toggle"
      {sysbar_vol})
    (label :class "sys-sep" :text " // ")
    (label :class "sys-item" :text {"BT: ${sysbar_bt}"})
    (label :class "sys-sep" :text " // ")
    (label :class "sys-item" :text {"CONN: ${sysbar_conn}"})
    (label :class "sys-sep" :text " // ")
    (label :class "sys-item" :text {conn_scroll})
    (label :class "sys-sep" :text " // ")
    (label :class "sys-item" :text {sysbar_ssh})))
