      "FILES")
    (label :class "launcher-divider" :text "------------")
    (button :class "launcher-item"
      :onclick "zsh -i -c 'loadout' &"
      "LOADOUT")))

(defpoll vpnstatus :interval "5s"
  "if pgrep openvpn > /dev/null; then echo 'CONNECTED'; else echo 'OFFLINE'; fi")

(defpoll vpnip :interval "5s"
  "if pgrep openvpn > /dev/null; then echo \"IP: $(curl -s --max-time 5 icanhazip.com 2>/dev/null || echo 'TUNNEL ACTIVE')\"; else echo 'IP: HIDDEN'; fi")

(defpoll vpnserver :interval "30s"
  "if pgrep openvpn > /dev/null; then echo 'SERVER: US-FREE-111'; else echo 'SERVER: NONE'; fi")

(defpoll vpnuptime :interval "5s"
  "if pgrep openvpn > /dev/null; then echo \"UPTIME: $(ps -o etime= -p $(pgrep openvpn) | tr -d ' ')\"; else echo 'UPTIME: N/A'; fi")

(defwindow vpn
  :monitor 0
  :geometry (geometry
    :x "14px"
    :x "0px"
    :y "0px"
    :width "700px"
    :height "55px"
    :anchor "center top")
  :stacking "bg"
  :exclusive false
  (box :class "vpn-box"
    :orientation "h"
    :space-evenly true
    :spacing 12
    (label :class "vpn-title" :text "⬡ VPN")
    (label :class "vpn-status" :text {vpnstatus})
    (label :class "vpn-ip" :text {vpnip})
    (label :class "vpn-server" :text {vpnserver})
    (label :class "vpn-uptime" :text {vpnuptime})
    (button :class "vpn-btn-on"
      :onclick "vpn-on &"
      "[+ON+]")
    (button :class "vpn-btn-off"
      :onclick "vpn-off &"
      "[-OFF-]")))
