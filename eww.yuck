  :exclusive false
  (box :class "launcher-box"
    :orientation "v"
    :space-evenly false
    :spacing 0
    :valign "center"
    (label :class "launcher-title" :text "[ 4R53N4L ]")
    (label :class "launcher-divider" :text "------------")
    (button :class "launcher-item"
      :onclick "brave-browser &"
      "BRAVE")
    (label :class "launcher-divider" :text "------------")
