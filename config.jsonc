{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 8,
    "margin-top": 0,
    "margin-left": 12,
    "margin-right": 12,
    "modules-left": [
        "tray",
        "mpris"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/power",
        "cpu",
        "memory",
        "temperature",
        "battery",
        "network",
        "pulseaudio"
    ],
    "clock": {
        "format": "⬡ {:%H:%M // %d.%m.%Y}",
        "tooltip-format": "{:%A, %B %d %Y}"
    },
    "cpu": {
        "format": "CPU {usage}%",
        "interval": 2
    },
    "memory": {
        "format": "MEM {}%",
        "interval": 2
    },
    "temperature": {
        "format": "TEMP {temperatureC}°C"
    },
    "battery": {
        "format": "PWR {capacity}%",
        "format-charging": "CHR {capacity}%",
        "format-critical": "LOW {capacity}%",
        "critical": 20
    },
    "network": {
        "format-wifi": "NET {signalStrength}% ↑{bandwidthUpBytes} ↓{bandwidthDownBytes}",
        "format-disconnected": "NET --",
        "interval": 2
    },
    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "MUTE",
        "on-click": "pavucontrol"
    },
    "custom/power": {
        "format": "⏻",
        "on-click": "wlogout",
        "tooltip": false
    },
    "mpris": {
        "format": "🎵 {artist} - {title}",
        "format-paused": "⏸ {artist} - {title}",
        "player": "brave",
        "max-length": 40
    }
}
